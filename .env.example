# ローカル開発用の環境変数。`.env.local` にコピーして値を埋める。
# 本番・Preview の値は infra/ の Terraform が Vercel に設定する。

# Postgres 接続文字列。ローカルは compose.yaml の Postgres、または Neon の dev ブランチ。
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lifehub

# better-auth のセッション署名用シークレット（32文字以上のランダム文字列）
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# アプリの公開 URL。ローカルは vite dev のオリジン。
APP_URL=http://localhost:5173

# Vercel Cron が /api/cron/* を呼ぶときの Bearer トークン
CRON_SECRET=change-me

# Upstash QStash（US = us-east-1 リージョンの値。エンドポイントは server/lib/qstash.ts に固定）。
# 未設定なら通知の予約を行わない。
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Web Push の VAPID 鍵ペア（`pnpm vapid:generate` で生成）
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Sentry の DSN。ローカルでは空のままにする（エラー・トレース・ログを本番の Sentry に送らない）。本番の値は infra/sentry.tf が設定する。
SENTRY_DSN=

# Money Forward ME の取り込み（docs/features/money.md）。有料プラン（入出金の CSV ダウンロード）が前提。
# 口座は「種類:名前」をカンマで区切って並べる。種類は bank（残高）/ securities（評価額）/ card（次回の引き落とし）。
# 名前は Money Forward の口座一覧に出る金融機関の名前。並べた順がお金の画面のカードの順になる。
# 2 段階認証（認証アプリ）を使っていなければ MONEYFORWARD_TOTP_SECRET は空のまま。
# グループで絞らなければ MONEYFORWARD_GROUP は空のまま。
MONEYFORWARD_EMAIL=
MONEYFORWARD_PASSWORD=
MONEYFORWARD_TOTP_SECRET=
MONEYFORWARD_GROUP=
MONEYFORWARD_ACCOUNTS=bank:三井住友銀行,securities:SBI証券,card:楽天カード
