# ローカル開発用の環境変数。`.env.local` にコピーして値を埋める。
# 本番・Preview の値は infra/ の Terraform が Vercel に設定する。

# Postgres 接続文字列。ローカルは compose.yaml の Postgres、または Neon の dev ブランチ。
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lifehub

# better-auth のセッション署名用シークレット（32文字以上のランダム文字列）
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# アプリの公開 URL。ローカルは vite dev のオリジン。
APP_URL=http://localhost:5173

# Vercel Cron が /api/notifications/enqueue を呼ぶときの Bearer トークン
CRON_SECRET=change-me

# Upstash QStash（M6 以降）。未設定なら通知の予約を行わない。
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Web Push の VAPID 鍵ペア（`pnpm vapid:generate` で生成）
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
