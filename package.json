  "scripts": {
    "dev": "concurrently -n web,api -c blue,magenta \"vite\" \"tsx watch --env-file-if-exists=.env.local server/dev.ts\"",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.shared.json && tsc -p tsconfig.server.json && tsc -p tsconfig.client.json && tsc -p tsconfig.e2e.json",
    "lint": "biome check . && knip",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:dump": "tsx --env-file-if-exists=.env.local scripts/db-dump.ts",
    "db:restore": "tsx --env-file-if-exists=.env.local scripts/db-restore.ts",
    "user:create": "tsx --env-file-if-exists=.env.local scripts/create-user.ts",
    "user:reset-password": "tsx --env-file-if-exists=.env.local scripts/reset-password.ts",
    "vapid:generate": "tsx scripts/generate-vapid-keys.ts",
    "tf:plan": "terraform -chdir=infra plan",
    "tf:apply": "terraform -chdir=infra apply",
    "icons:generate": "tsx --tsconfig tsconfig.server.json scripts/generate-icons.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed-dev.ts && pnpm data:refresh",
    "data:refresh": "tsx --env-file-if-exists=.env.local scripts/refresh-calendar-data.ts",
    "calendar:export": "tsx --env-file-if-exists=.env.local scripts/export-ics.ts"
  }
