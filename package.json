    "@hono/mcp": "^0.3.2",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@neondatabase/serverless": "^1.1.0",
    "@tanstack/query-async-storage-persister": "^5.103.1",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-query-persist-client": "^5.103.1",
    "@tanstack/react-router": "^1.170.38",
    "@upstash/qstash": "^2.11.3",
    "@vercel/functions": "^3.9.8",
    "better-auth": "^1.7.5",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.8",
    "ical-generator": "^11.1.1",
    "ical.js": "^2.2.1",
    "idb-keyval": "^6.3.0",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rrule": "^2.8.1",
    "uuid": "^14.0.2",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@tanstack/router-plugin": "^1.168.40",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/culori": "^4.0.1",
    "@types/node": "^26.6.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "culori": "^4.0.2",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^30.1.0",
    "knip": "^6.36.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vercel": "^59.23.1",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c blue,magenta \"vite\" \"tsx watch --env-file-if-exists=.env.local server/dev.ts\"",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.shared.json && tsc -p tsconfig.server.json && tsc -p tsconfig.client.json && tsc -p tsconfig.e2e.json",
    "lint": "biome check . && knip",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:dump": "tsx --env-file-if-exists=.env.local scripts/db-dump.ts",
    "db:restore": "tsx --env-file-if-exists=.env.local scripts/db-restore.ts",
    "user:create": "tsx --env-file-if-exists=.env.local scripts/create-user.ts",
    "vapid:generate": "tsx scripts/generate-vapid-keys.ts",
    "tf:plan": "terraform -chdir=infra plan",
    "tf:apply": "terraform -chdir=infra apply",
    "icons:generate": "tsx --tsconfig tsconfig.server.json scripts/generate-icons.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed-dev.ts && pnpm data:refresh",
    "data:refresh": "tsx --env-file-if-exists=.env.local scripts/refresh-calendar-data.ts",
    "calendar:export": "tsx --env-file-if-exists=.env.local scripts/export-ics.ts"
  }
}
