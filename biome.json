{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!src/routeTree.gen.ts", "!drizzle", "!dist", "!dev-dist", "!infra"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "useConst": "error"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error"
      },
      "a11y": {
        "useSemanticElements": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/features/*/components/**", "src/features/*/cards/**", "src/routes/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/lib/api.ts"],
                    "message": "API はコンポーネントから直接呼ばず、features/*/queries.ts のフック経由にする"
                  },
                  {
                    "group": ["@mui/material/Dialog"],
                    "message": "ダイアログは lib/ui/Dialog.tsx を使う（履歴に項目を持ち、ブラウザバックで閉じるため）"
                  },
                  {
                    "group": [
                      "@mui/material/Modal",
                      "@mui/material/Popover",
                      "@mui/material/Drawer"
                    ],
                    "message": "重ねて開く入れ物は lib/ui の Dialog / RecordSheet を使う（履歴に項目を持ち、ブラウザバックで閉じるため）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/events/components/QuickEventForm.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/lib/api.ts"],
                    "message": "API はコンポーネントから直接呼ばず、features/*/queries.ts のフック経由にする"
                  },
                  {
                    "group": ["@mui/material/Dialog"],
                    "message": "ダイアログは lib/ui/Dialog.tsx を使う（履歴に項目を持ち、ブラウザバックで閉じるため）"
                  },
                  {
                    "group": ["@mui/material/Modal", "@mui/material/Drawer"],
                    "message": "重ねて開く入れ物は lib/ui の Dialog / RecordSheet を使う（履歴に項目を持ち、ブラウザバックで閉じるため）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/**/*.tsx",
        "!src/main.tsx",
        "!src/routes/**",
        "!src/features/calendar/components/DraftBlock.tsx",
        "!src/features/calendar/components/SwipePager.tsx",
        "!src/features/events/components/TaskCheckbox.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "useComponentExportOnlyModules": "error"
          }
        }
      }
    },
    {
      "includes": ["src/lib/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/features/**"],
                    "message": "lib は機能をまたぐ土台なので features を読まない（依存は features → lib の一方向）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["server/features/*/routes.ts", "server/features/*/mcp.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["./repository.ts", "**/repository.ts"],
                    "message": "routes.ts / mcp.ts は入力を検証して service を呼ぶだけにする（repository を直接呼ばない）"
                  },
                  {
                    "group": ["**/lib/db.ts", "drizzle-orm", "drizzle-orm/**"],
                    "message": "DB は repository.ts からだけ触る"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "server/features/**/*.ts",
        "!server/features/*/routes.ts",
        "!server/features/*/mcp.ts",
        "!server/features/*/repository.ts",
        "!server/features/*/schema.ts",
        "!server/features/*/__tests__/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/lib/db.ts", "drizzle-orm", "drizzle-orm/**"],
                    "message": "DB は repository.ts からだけ触る（service は repository を通す）"
                  },
                  {
                    "group": ["../*/repository.ts"],
                    "message": "他の feature の repository は直接使わず、その feature の service を通す"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["server/lib/**/*.ts", "!server/lib/**/__tests__/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/features/*/repository.ts"],
                    "message": "lib から feature の repository は直接使わず、その feature の service を通す"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["server/lib/notifications/service.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/lib/db.ts", "../db.ts", "drizzle-orm", "drizzle-orm/**"],
                    "message": "DB は repository.ts からだけ触る（送信済み台帳は notifications/repository.ts）"
                  },
                  {
                    "group": ["**/features/*/repository.ts"],
                    "message": "lib から feature の repository は直接使わず、その feature の service を通す"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
