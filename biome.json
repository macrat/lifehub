{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!src/routeTree.gen.ts", "!drizzle", "!dist", "!dev-dist", "!infra"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "plugins": ["./lint/mui-color-prop-path.grit", "./lint/named-middleware.grit"],
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noImportCycles": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "useConst": "error",
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": {
            "maxLines": 400
          }
        }
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error"
      },
      "a11y": {
        "useSemanticElements": "error"
      },
      "complexity": {
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 100
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["shared/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/server/**", "**/src/**"],
                    "message": "shared はクライアントとサーバーの両方が読む土台なので、どちらのコードも読まない"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["server/**", "api/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/src/**"],
                    "message": "サーバーはクライアントのコードを読まない（共有するものは shared/ に置く）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "server/**/*.ts",
        "!**/repository.ts",
        "!**/schema.ts",
        "!server/lib/db/**",
        "!server/**/__tests__/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/src/**"],
                    "message": "サーバーはクライアントのコードを読まない（共有するものは shared/ に置く）"
                  },
                  {
                    "group": [
                      "**/lib/db/**",
                      "!**/db/auth-adapter.ts",
                      "!**/db/health.ts",
                      "drizzle-orm",
                      "drizzle-orm/**"
                    ],
                    "message": "DB は repository.ts と lib/db からだけ触る（service や lib の処理は repository を通す）。lib/db の外から使ってよいのは auth-adapter.ts と health.ts だけ"
                  },
                  {
                    "group": ["**/repository.ts", "!./repository.ts"],
                    "message": "他の feature の repository は直接使わず、その feature の service を通す（自分の ./repository.ts だけを読む）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["server/features/*/routes.ts", "server/features/*/mcp.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/src/**"],
                    "message": "サーバーはクライアントのコードを読まない（共有するものは shared/ に置く）"
                  },
                  {
                    "group": [
                      "**/lib/db/**",
                      "!**/db/auth-adapter.ts",
                      "!**/db/health.ts",
                      "drizzle-orm",
                      "drizzle-orm/**"
                    ],
                    "message": "DB は repository.ts と lib/db からだけ触る（service や lib の処理は repository を通す）。lib/db の外から使ってよいのは auth-adapter.ts と health.ts だけ"
                  },
                  {
                    "group": ["./repository.ts", "**/repository.ts"],
                    "message": "routes.ts / mcp.ts は入力を検証して service を呼ぶだけにする（repository を直接呼ばない）"
                  },
                  {
                    "group": ["@hono/zod-validator"],
                    "message": "入力の検証は server/lib/validator.ts の validate を使う（失敗の応答を 1 つの形にそろえる）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["server/lib/**/*.ts", "!server/lib/db/**", "!server/**/__tests__/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/src/**"],
                    "message": "サーバーはクライアントのコードを読まない（共有するものは shared/ に置く）"
                  },
                  {
                    "group": [
                      "**/lib/db/**",
                      "./db/**",
                      "../db/**",
                      "!**/db/auth-adapter.ts",
                      "!**/db/health.ts",
                      "drizzle-orm",
                      "drizzle-orm/**"
                    ],
                    "message": "DB は repository.ts と lib/db からだけ触る（service や lib の処理は repository を通す）。lib/db の外から使ってよいのは auth-adapter.ts と health.ts だけ"
                  },
                  {
                    "group": ["**/features/**", "!**/features/*/schema.ts"],
                    "message": "lib は feature をまたぐ土台なので features を読まない（DB の表の定義 schema.ts だけは読める）。feature を組み立てるのは server/ 直下（app.ts・cron.ts・qstash.ts・mcp.ts）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["server/lib/db/**/*.ts", "!server/**/__tests__/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/src/**"],
                    "message": "サーバーはクライアントのコードを読まない（共有するものは shared/ に置く）"
                  },
                  {
                    "group": ["**/features/**", "!**/features/*/schema.ts"],
                    "message": "lib は feature をまたぐ土台なので features を読まない（DB の表の定義 schema.ts だけは読める）。feature を組み立てるのは server/ 直下（app.ts・cron.ts・qstash.ts・mcp.ts）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/server/**"],
                    "message": "クライアントはサーバーのコードを読まない（API の型は src/lib/api.ts が AppType を型としてだけ読む）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/lib/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/server/**"],
                    "message": "クライアントはサーバーのコードを読まない（API の型は src/lib/api.ts が AppType を型としてだけ読む）"
                  },
                  {
                    "group": ["**/features/**"],
                    "message": "lib は機能をまたぐ土台なので features を読まない（依存は features → lib の一方向）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/lib/api.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/server/**", "!**/server/app.ts"],
                    "message": "クライアントはサーバーのコードを読まない。API の型（server/app.ts の AppType）だけを import type で読む"
                  },
                  {
                    "group": ["**/features/**"],
                    "message": "lib は機能をまたぐ土台なので features を読まない（依存は features → lib の一方向）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/**", "src/routes/**", "!src/features/*/queries.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/server/**"],
                    "message": "クライアントはサーバーのコードを読まない（API の型は src/lib/api.ts が AppType を型としてだけ読む）"
                  },
                  {
                    "group": ["**/lib/api.ts"],
                    "message": "API は features/*/queries.ts からだけ呼ぶ（画面・部品・フックはクエリのフックを通す）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/*/components/**", "src/routes/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/server/**"],
                    "message": "クライアントはサーバーのコードを読まない（API の型は src/lib/api.ts が AppType を型としてだけ読む）"
                  },
                  {
                    "group": ["**/lib/api.ts"],
                    "message": "API は features/*/queries.ts からだけ呼ぶ（画面・部品・フックはクエリのフックを通す）"
                  },
                  {
                    "group": ["@mui/material/Dialog"],
                    "message": "ダイアログは lib/ui/Dialog.tsx を使う（履歴に項目を持ち、ブラウザバックで閉じるため）"
                  },
                  {
                    "group": [
                      "@mui/material/Modal",
                      "@mui/material/Popover",
                      "@mui/material/Drawer"
                    ],
                    "message": "重ねて開く入れ物は lib/ui の Dialog / RecordSheet を使う（履歴に項目を持ち、ブラウザバックで閉じるため）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/features/events/**",
        "!src/features/events/queries.ts",
        "!src/features/events/components/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/server/**"],
                    "message": "クライアントはサーバーのコードを読まない（API の型は src/lib/api.ts が AppType を型としてだけ読む）"
                  },
                  {
                    "group": ["**/lib/api.ts"],
                    "message": "API は features/*/queries.ts からだけ呼ぶ（画面・部品・フックはクエリのフックを通す）"
                  },
                  {
                    "group": ["**/calendar/**"],
                    "message": "予定・タスクのデータは events が持ち、calendar はそれを暦に並べる画面。依存は calendar → events の一方向にする"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/events/components/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/server/**"],
                    "message": "クライアントはサーバーのコードを読まない（API の型は src/lib/api.ts が AppType を型としてだけ読む）"
                  },
                  {
                    "group": ["**/lib/api.ts"],
                    "message": "API は features/*/queries.ts からだけ呼ぶ（画面・部品・フックはクエリのフックを通す）"
                  },
                  {
                    "group": ["@mui/material/Dialog"],
                    "message": "ダイアログは lib/ui/Dialog.tsx を使う（履歴に項目を持ち、ブラウザバックで閉じるため）"
                  },
                  {
                    "group": [
                      "@mui/material/Modal",
                      "@mui/material/Popover",
                      "@mui/material/Drawer"
                    ],
                    "message": "重ねて開く入れ物は lib/ui の Dialog / RecordSheet を使う（履歴に項目を持ち、ブラウザバックで閉じるため）"
                  },
                  {
                    "group": ["**/calendar/**"],
                    "message": "予定・タスクのデータは events が持ち、calendar はそれを暦に並べる画面。依存は calendar → events の一方向にする"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/events/queries.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/server/**"],
                    "message": "クライアントはサーバーのコードを読まない（API の型は src/lib/api.ts が AppType を型としてだけ読む）"
                  },
                  {
                    "group": ["**/calendar/**"],
                    "message": "予定・タスクのデータは events が持ち、calendar はそれを暦に並べる画面。依存は calendar → events の一方向にする"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/**", "!src/lib/api.ts", "!src/**/__tests__/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "fetch": "API への要求は src/lib/api.ts の apiRequestFetch（か、それを使う api）を通す。素の fetch は Sentry のトレースで画面の移動のスパンの子になり、移動が打ち切られると所要時間が短く記録される"
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/**/*.tsx", "!src/main.tsx", "!src/routes/**"],
      "linter": {
        "rules": {
          "style": {
            "useComponentExportOnlyModules": "error"
          }
        }
      }
    },
    {
      "includes": ["**/__tests__/**", "e2e/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": "off"
          }
        }
      }
    }
  ]
}
